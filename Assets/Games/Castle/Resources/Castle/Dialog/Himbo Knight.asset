  m_Name: Himbo Knight
  m_EditorClassIdentifier: 
  resourceName: Himbo Knight
  displayName: Old tales
  icon: {fileID: 0}
  iconBackgroundImage: {fileID: 0}
  description: 
  useRegionalDescription: 0
  resourceDescriptionProfile: 
  optionalOverride: 0
