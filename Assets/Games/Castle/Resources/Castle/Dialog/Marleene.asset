  m_Script: {fileID: 11500000, guid: fd3ecde65e0933d4d8e78e24e9ae3820, type: 3}
  m_Name: Marleene
  m_EditorClassIdentifier: 
  resourceName: Sisters
  displayName: 
  icon: {fileID: 0}
  iconBackgroundImage: {fileID: 0}
  description: 
  useRegionalDescription: 0
  resourceDescriptionProfile: 
  optionalOverride: 0
  automatic: 0
  repeatable: 0
  audioProfileName: 
  dialogNodes:
  - startTime: 0
    showTime: 0
    description: 'Taking care of these horses can be a grueling task at times..


      Usually
      my most beloved sister is here to help.


      However, a great misfortune
      has befallen her...'
    audioClip: {fileID: 0}
    nextOption: What happened?
  - startTime: 0
    showTime: 0
    description: "Her betrothed is on the run, \nbelieving himself unworthy of her
      affection and status.\n\nMy poor sister is devistated to say the least... \n\n"
    audioClip: {fileID: 0}
    nextOption: 
  - startTime: 0
    showTime: 0
    description: "I have done everything in my power to console her,\nbut the work
      here is never-ending, \nand i am forced to leave her, all alone, at this state...\n\n"
    audioClip: {fileID: 0}
    nextOption: I am sorry for your misfortunes
  - startTime: 0
    showTime: 0
    description: "Would you mind, perhaps, keeping her company? \n\nI can see it
      in your eyes, you look trustworthy.\n\nIf you even so manage to console her,
      \nI would be indebted to you, \nand you will be rewarded handsomely!\n\n"
    audioClip: {fileID: 0}
    nextOption: I guess i can give it a try!
  prerequisiteConditions: []
